<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CollegeFestMVC</RootNamespace>
    <AssemblyName>CollegeFestMVC</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MySQL driver (plain ADO.NET, no Entity Framework needed) -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

</Project>
